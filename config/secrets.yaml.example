# 密钥覆盖层模板：复制本文件为 secrets.yaml 并填入真实值。
# secrets.yaml 已被 .gitignore 排除，永远不会进 git。
# 启动时深合并进 config.yaml（同名键以本文件为准）。

push:
  email:
    # SMTP 授权码（不是邮箱登录密码）：
    #   QQ邮箱：设置 -> 账户 -> POP3/IMAP/SMTP 服务 -> 开启并生成授权码
    #   163邮箱：设置 -> POP3/SMTP/IMAP -> 开启并新增授权密码
    password: "你的SMTP授权码"

  # ---- 飞书群自定义机器人（群设置 -> 群机器人 -> 添加机器人 -> 自定义机器人）----
  # 地址形如 https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
  # 安全设置建议勾「签名校验」，把密钥填到 secret；只勾「自定义关键词」时 secret 留空
  feishu:
    enabled: true
    webhook_url: "https://open.feishu.cn/open-apis/bot/v2/hook/你的token"
    secret: "你的飞书加签密钥"

  # ---- 钉钉群自定义机器人（群设置 -> 机器人 -> 添加机器人 -> 自定义）----
  # 地址形如 https://oapi.dingtalk.com/robot/send?access_token=xxxx
  # 安全设置选「加签」时把密钥填到 secret（注意地址里的 access_token 已自带，无需手动拼）
  dingtalk:
    enabled: true
    webhook_url: "https://oapi.dingtalk.com/robot/send?access_token=你的token"
    secret: "你的钉钉加签密钥"

intent:
  llm:
    # 意图解析的大模型 key（OpenAI 兼容协议均可）：
    #   DeepSeek：platform.deepseek.com 充值后建 key；base_url/model 用默认即可
    #   豆包/火山方舟：console.volcengine.com/ark 建推理接入点；model 填 ep- 开头的接入点 ID
    #   通义千问：bailian.console.aliyun.com 建 key；base_url 改 compatible-mode/v1，model 填 qwen-plus
    api_key: "你的LLM-APIKey"
    # base_url: "https://api.deepseek.com/v1"
    # model: "deepseek-chat"
