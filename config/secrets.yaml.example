# 密钥覆盖层模板：复制本文件为 secrets.yaml 并填入真实值。
# secrets.yaml 已被 .gitignore 排除，永远不会进 git。
# 启动时深合并进 config.yaml（同名键以本文件为准）。

push:
  email:
    # SMTP 授权码（不是邮箱登录密码）：
    #   QQ邮箱：设置 -> 账户 -> POP3/IMAP/SMTP 服务 -> 开启并生成授权码
    #   163邮箱：设置 -> POP3/SMTP/IMAP -> 开启并新增授权密码
    password: "你的SMTP授权码"

intent:
  llm:
    # 意图解析的大模型 key（OpenAI 兼容协议均可）：
    #   DeepSeek：platform.deepseek.com 充值后建 key；base_url/model 用默认即可
    #   豆包/火山方舟：console.volcengine.com/ark 建推理接入点；model 填 ep- 开头的接入点 ID
    #   通义千问：bailian.console.aliyun.com 建 key；base_url 改 compatible-mode/v1，model 填 qwen-plus
    api_key: "你的LLM-APIKey"
    # base_url: "https://api.deepseek.com/v1"
    # model: "deepseek-chat"
